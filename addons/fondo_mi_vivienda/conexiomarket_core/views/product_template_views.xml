<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_view_inherit_market" model="ir.ui.view">
            <field name="name">product.template.form.inherit.market</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_product_mappings" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-link"
                            groups="conexiomarket_core.group_market_connector_user"
                        >
                        <field name="mapping_count" widget="statinfo" string="Marketplaces"/>
                    </button>
                </div>
            </field>
        </record>
    </data>
</odoo>