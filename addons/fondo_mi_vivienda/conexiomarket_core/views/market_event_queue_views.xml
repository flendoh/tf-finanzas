<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_market_event_queue_form" model="ir.ui.view">
        <field name="name">market.event.queue.form</field>
        <field name="model">market.event.queue</field>
        <field name="arch" type="xml">
            <form string="Cola de Eventos" create="0" edit="0">
                <header>
                    <button name="action_retry" string="Reintentar" type="object" invisible="state != 'failed'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processing,done,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="backend_type"/>
                            <field name="event_type"/>
                        </group>
                        <group>
                            <field name="model_id"/>
                            <field name="res_id"/>
                            <field name="record_ref"/>
                            <field name="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Datos a Enviar">
                            <field name="payload" widget="code" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Logs" invisible="not log_notes">
                            <field name="log_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_market_event_queue_list" model="ir.ui.view">
        <field name="name">market.event.queue.list</field>
        <field name="model">market.event.queue</field>
        <field name="arch" type="xml">
            <list string="Cola de Salida" create="0" decoration-danger="state=='failed'" decoration-info="state=='pending'" decoration-muted="state=='done'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="account_id"/>
                <field name="model_id"/>
                <field name="record_ref"/>
                <field name="state"/>
                <field name="priority"/>
            </list>
        </field>
    </record>

    <record id="action_market_event_queue" model="ir.actions.act_window">
        <field name="name">Cola de Salida</field>
        <field name="res_model">market.event.queue</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay eventos pendientes.
            </p>
        </field>
    </record>
</odoo>
