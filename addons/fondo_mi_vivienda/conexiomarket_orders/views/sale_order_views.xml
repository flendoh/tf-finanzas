<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit_marketplace_connector_orders" model="ir.ui.view">
            <field name="name">sale.order.view.form.inherit.market</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page name="marketplace_page" string="Detalles Marketplace" invisible="not marketplace_account_id">
                        <group>
                            <group string="Información Principal">
                                <field name="marketplace_account_id" />
                                <field name="marketplace_order_number" invisible="not marketplace_order_number"/>
                                <field name="marketplace_invoice_required" widget="boolean_toggle"/>
                                <field name="marketplace_external_id" invisible="not marketplace_external_id" groups="base.group_no_one"/>
                            </group>
                            <group string="Fechas Importantes">
                                <field name="marketplace_date_order" invisible="not marketplace_date_order"/>
                                <field name="marketplace_shipping_deadline" invisible="not marketplace_shipping_deadline"/>
                            </group>
                        </group>
                        <group string="Información Técnica" groups="base.group_no_one">
                            <field name="write_date" string="Fecha de Actualización"/>
                            <field name="marketplace_webhook_id" />
                            <field name="marketplace_raw_data" widget="code" options="{'mode': 'json'}"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>    
    </data>
</odoo>