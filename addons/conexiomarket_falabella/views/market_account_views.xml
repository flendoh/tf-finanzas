<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_market_account_form_inherit_market_connector_falabella" model="ir.ui.view">
            <field name="name">market.account.view.form.inherit.falabella</field>
            <field name="model">market.account</field>
            <field name="inherit_id" ref="conexiomarket_core.view_market_account_form"/>
            <field name="arch" type="xml">

                <xpath expr="//page[@name='credentials_page']" position="inside">
                    <group invisible="backend_type != 'falabella'">
                        <field name="falabella_base_url" />
                        <field name="falabella_seller_id" required="backend_type == 'falabella'"/>
                        <field name="falabella_user_id" required="backend_type == 'falabella'" password="True"/>
                        <field name="falabella_api_key" required="backend_type == 'falabella'" password="True"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
