<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_market_product_mapping" model="ir.actions.act_window">
            <field name="name">Productos Mapeados</field>
            <field name="res_model">market.product.mapping</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('account_id', '=', active_id)]</field>
            <field name="context">{'default_account_id': active_id}</field>
        </record>

        <record id="market_product_mapping_view_list" model="ir.ui.view">
            <field name="name">market_product_mapping.view.list</field>
            <field name="model">market.product.mapping</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="account_id" options="{'no_create': true}"/>
                    <field name="product_id" />
                    <field name="external_id" />
                    <field name="active" />
                </list>
            </field>
        </record>
    </data>
</odoo>
