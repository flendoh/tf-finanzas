<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_market_webhook_entry_form" model="ir.ui.view">
        <field name="name">market.webhook.entry.form</field>
        <field name="model">market.webhook.entry</field>
        <field name="arch" type="xml">
            <form string="Webhook Entry" create="0" edit="0">
                <header>
                    <button name="action_process" string="Procesar Ahora" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_retry" string="Reintentar" type="object" invisible="state != 'failed'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_record" type="object" class="oe_stat_button" icon="fa-external-link" invisible="not res_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Registro</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="backend_type"/>
                            <field name="model_id"/>
                            <field name="res_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="retry_count"/>
                            <field name="last_error" decoration-danger="1" invisible="not last_error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload" widget="code" options="{'language': 'json'}"/>
                        </page>
                        <page string="Headers">
                            <field name="headers"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_market_webhook_entry_list" model="ir.ui.view">
        <field name="name">market.webhook.entry.list</field>
        <field name="model">market.webhook.entry</field>
        <field name="arch" type="xml">
            <list string="Webhooks" create="0" decoration-danger="state=='failed'" decoration-info="state=='draft'" decoration-muted="state=='done'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="account_id"/>
                <field name="model_id"/>
                <field name="state"/>
                <field name="retry_count"/>
            </list>
        </field>
    </record>

    <record id="view_market_webhook_entry_search" model="ir.ui.view">
        <field name="name">market.webhook.entry.search</field>
        <field name="model">market.webhook.entry</field>
        <field name="arch" type="xml">
            <search string="Búsqueda de Webhooks">
                <field name="name"/>
                <field name="account_id"/>
                <field name="model_id"/>
                <field name="res_id"/>
                
                <separator/>
                <filter string="Pendiente" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Procesado" name="state_done" domain="[('state', '=', 'done')]"/>
                <filter string="Fallido" name="state_failed" domain="[('state', '=', 'failed')]"/>
                
                <group expand="0" string="Agrupar Por">
                    <filter string="Cuenta" name="group_by_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Modelo" name="group_by_model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_market_webhook_entry" model="ir.actions.act_window">
        <field name="name">Entradas (Webhooks)</field>
        <field name="res_model">market.webhook.entry</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay webhooks recibidos aún.
            </p>
        </field>
    </record>
</odoo>
