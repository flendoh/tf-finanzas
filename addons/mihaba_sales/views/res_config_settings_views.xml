<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_mihaba_sales" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mihaba.sales</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='sale_shipping_setting_container']" position="inside">
                <setting id="warehouse_manager" string="Almacenero/Encargado de Despacho" help="Usuario responsable del almacén que recibirá actividades">
                    <field name="warehouse_manager_id"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
