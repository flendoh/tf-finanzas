<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit_marketplace_connector_orders" model="ir.ui.view">
            <field name="name">sale.order.view.form.inherit.market</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_webhooks"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bolt"
                            invisible="not marketplace_account_id"
                            groups="conexiomarket_core.group_market_connector_user">
                        <field name="marketplace_webhook_count" widget="statinfo" string="Webhooks"/>
                    </button>
                </div>
                <xpath expr="//notebook" position="inside">
                    <page name="marketplace_page" string="Detalles Marketplace" invisible="not marketplace_account_id">
                        <div name="marketplace_button_box">
                            <button name="action_get_marketplace_document"
                                    type="object"
                                    class="btn-secondary"
                                    icon="fa-file-text-o"
                                    string="Descargar Documento"
                                    invisible="not feature_order_document"
                            />
                        </div>
                        <field name="feature_order_document" invisible="1"/>
                        <group>
                            <group string="Información Principal">
                                <field name="marketplace_account_id" />
                                <field name="marketplace_order_number" invisible="not marketplace_order_number"/>
                                <button name="action_open_marketplace_url" type="object" class="btn btn-link ps-0 pt-0 pb-2" icon="oi-arrow-right" string="Ver Orden en Marketplace" colspan="2" invisible="not feature_open_marketplace_url"/>
                                <field name="marketplace_invoice_required" widget="boolean_toggle"/>
                                <field name="marketplace_external_id" invisible="not marketplace_external_id" groups="base.group_no_one"/>
                            </group>
                            <group string="Fechas Importantes">
                                <field name="marketplace_date_order" invisible="not marketplace_date_order"/>
                                <field name="marketplace_shipping_deadline" invisible="not marketplace_shipping_deadline"/>
                            </group>
                        </group>
                        <group string="Información Técnica" groups="base.group_no_one">
                            <field name="write_date" string="Fecha de Actualización"/>
                            <field name="marketplace_last_webhook_id"/>
                            <field name="marketplace_last_raw_data" widget="code" options="{'language': 'json'}"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>    
    </data>
</odoo>